  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-e1e972c-20250221",
    "eas-build-cache-provider": "^16.4.2",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^12.0.1",
