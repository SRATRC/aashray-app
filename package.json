  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ]
      }
    }
  },
  "eslintConfig": {
    "extends": "universe/native",
    "root": true,
    "plugins": [
      "react-compiler"
    ],
    "rules": {
      "react-compiler/react-compiler": "warn"
    }
  },
  "private": true
}
