{
  "name": "aashray",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "lint:undef": "eslint --no-eslintrc -c .eslintrc.undef.json --ext .js,.jsx src \"*.js\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.54.1",
    "axios": "^1.6.8",
    "expo": "^58.0.19",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "nativewind": "latest",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-calendars": "^1.1305.0",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^3.3.0",
    "react-native-modal-datetime-picker": "18.0.0",
    "react-native-qrcode-styled": "^0.3.2",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.2.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eas-build-cache-provider": "^16.4.2",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^12.0.1",
    "expo-atlas": "^0.4.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ]
      }
    }
  },
  "eslintConfig": {
    "extends": "universe/native",
    "root": true,
    "overrides": [
      {
        "files": [
          "app.config.js",
          "babel.config.js",
          "metro.config.js",
          "prettier.config.js",
          "react-native.config.js",
          "tailwind.config.js"
        ],
        "env": {
          "node": true
        }
      }
    ]
  },
  "private": true
}
